APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Claude (Anthropic)
# ---------------------------------------------------------------------------
# Sin esta clave no funciona ninguna herramienta de IA. Se crea en
# console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Motor de currículums (ver config/resume.php)
# ---------------------------------------------------------------------------
# Modelos por tarea. Parseo y análisis son mecánicos y usan el modelo chico;
# adaptación y carta redactan, y usan el grande.
RESUME_MODEL_PARSING=claude-haiku-4-5
RESUME_MODEL_TAILORING=claude-opus-5
RESUME_MODEL_ANALYSIS=claude-haiku-4-5
RESUME_MODEL_COVER_LETTER=claude-opus-5
# Cuánto razona el modelo grande: low, medium, high, xhigh o max.
RESUME_AI_EFFORT=medium
# El pipeline hace hasta 4 llamadas encadenadas: 30s no siempre alcanzan.
RESUME_AI_TIMEOUT=120
RESUME_AI_RETRIES=2
# DejaVu Sans es la única familia con Unicode completo que trae DomPDF.
# Cambiarla sin instalar la fuente rompe tildes, guiones largos y viñetas.
RESUME_PDF_FONT="DejaVu Sans"
RESUME_PDF_PAPER=a4

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEEKLY_PLAN_ID=
MERCADOPAGO_MONTHLY_PLAN_ID=
MERCADOPAGO_YEARLY_PLAN_ID=

# ---------------------------------------------------------------------------
# Búsqueda de ofertas (config/jobsearch.php)
# Get on Board, Arbeitnow y Remotive no necesitan clave. Un portal sin clave se omite.
# ---------------------------------------------------------------------------
JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOB_SEARCH_MAX_AGE_DAYS=3
JOB_SEARCH_MAX_NEW_PER_SYNC=25
JOB_SEARCH_MIN_MATCH_SCORE=45
JOB_SEARCH_SYNC_CRON="17 7,19 * * *"
DEMO_USER_EMAIL=demo@atsboost.local
